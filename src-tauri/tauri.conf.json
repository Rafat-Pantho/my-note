{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Note",
  "version": "0.2.0",
  "identifier": "com.example.mynote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "My Note",
        "width": 900,
        "height": 650,
        "visible": false,
        "transparent": true,
        "backgroundColor": "#1e1e1e",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,msOneAuthWAM,msForceOneAuthWAM,NetworkErrorLogging,Reporting --autoplay-policy=no-user-gesture-required --no-proxy-server --host-resolver-rules=\"MAP * ~NOTFOUND\""
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      { "ext": ["txt"], "name": "Text document", "description": "Text document", "role": "Editor", "mimeType": "text/plain" },
      { "ext": ["md", "markdown"], "name": "Markdown document", "description": "Markdown document", "role": "Editor", "mimeType": "text/markdown" },
      { "ext": ["log"], "name": "Log file", "description": "Log file", "role": "Editor", "mimeType": "text/plain" }
    ],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
